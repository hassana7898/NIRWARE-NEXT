# NIRWARE NEXT - Environment Configuration Example

# Server Environment
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=nirware_next
DATABASE_URL=postgresql://postgres:your_secure_db_password@127.0.0.1:5432/nirware_next
TEST_DATABASE_URL=postgresql://postgres:your_secure_db_password@127.0.0.1:5432/nirware_next_test

# Authentication & Sessions
SESSION_SECRET=replace_with_secure_session_secret_min_32_chars
JWT_SECRET=replace_with_production_secure_jwt_secret_min_64_chars
COOKIE_DOMAIN=yourdomain.com
COOKIE_SECURE=true

# CORS (Comma separated allowed origins in production - no wildcard)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Security Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# External Services (Mocked in development, configured in production)
SMS_PROVIDER=mock
SMS_API_KEY=
PUSH_NOTIFICATION_PROVIDER=mock
AI_PROVIDER=mock
AI_API_KEY=

# Storage (local in dev, S3 compatible in prod)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
