# NIRWARE NEXT - Environment Configuration Example

# Server Environment
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres123@127.0.0.1:5432/nirware_next
TEST_DATABASE_URL=postgresql://postgres:postgres123@127.0.0.1:5432/nirware_next_test

# Authentication & Sessions
SESSION_SECRET=nirware-secure-session-secret-change-in-production-min-32-chars
JWT_SECRET=nirware-secure-jwt-secret-change-in-production-min-32-chars
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# CORS (Comma separated allowed origins in production - no wildcard)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Security Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# External Services (Mocked in development, configured in production)
SMS_PROVIDER=mock
SMS_API_KEY=
PUSH_NOTIFICATION_PROVIDER=mock
AI_PROVIDER=mock
AI_API_KEY=

# Storage (local in dev, S3 compatible in prod)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
