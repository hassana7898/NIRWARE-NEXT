# -------------------------------------------------------------
# NIRWARE NEXT - Production React Web & PWA Container
# Multi-stage Vite Build with Nginx
# -------------------------------------------------------------

FROM node:20-alpine AS builder

WORKDIR /app

# Copy root workspace config
COPY package*.json ./
COPY tsconfig.json ./
COPY packages/ ./packages/
COPY apps/web/ ./apps/web/

# Install dependencies and build shared packages + web bundle
RUN npm install
RUN npm --workspace=@nirware/config run build && \
    npm --workspace=@nirware/shared run build && \
    npm --workspace=@nirware/domain run build && \
    npm --workspace=@nirware/validation run build && \
    npm --workspace=@nirware/contracts run build && \
    npm --workspace=@nirware/ui run build && \
    npm --workspace=@nirware/api-client run build && \
    npm --workspace=@nirware/web run build

# Runner stage with Nginx
FROM nginx:1.27-alpine AS runner

COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
