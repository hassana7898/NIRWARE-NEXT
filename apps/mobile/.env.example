# ==============================================================================
# NIRWARE NEXT - Mobile Application Environment Configuration
# ==============================================================================
# In Expo SDK 52, variables prefixed with EXPO_PUBLIC_ are injected into the
# JavaScript bundle at build time (accessible via process.env.EXPO_PUBLIC_*).
#
# Choose ONE of the following configurations for your target environment:

# ------------------------------------------------------------------------------
# 1. Physical Android / iOS Device on Local Wi-Fi (Development)
# Replace with your workstation's LAN IP address:
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000/api/v1

# ------------------------------------------------------------------------------
# 2. Android Studio Emulator (Standard Android Loopback)
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api/v1

# ------------------------------------------------------------------------------
# 3. Production / Staging Server (HTTPS Domain)
# EXPO_PUBLIC_API_URL=https://api.nirware.ir/api/v1
