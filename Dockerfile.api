# -------------------------------------------------------------
# NIRWARE NEXT - Production API Container
# Multi-stage Node.js Build
# -------------------------------------------------------------

FROM node:20-alpine AS builder

WORKDIR /app

# Copy root workspace config
COPY package*.json ./
COPY tsconfig.json ./
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/

# Install dependencies and build shared packages + API
RUN npm install
RUN npm --workspace=@nirware/config run build && \
    npm --workspace=@nirware/shared run build && \
    npm --workspace=@nirware/domain run build && \
    npm --workspace=@nirware/validation run build && \
    npm --workspace=@nirware/contracts run build && \
    npm --workspace=@nirware/ui run build && \
    npm --workspace=@nirware/api-client run build && \
    npm --workspace=@nirware/api run build

# Runner stage
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

# Copy root manifests and built packages
COPY package*.json ./
COPY tsconfig.json ./
COPY packages/ ./packages/
COPY apps/api/package.json ./apps/api/
COPY --from=builder /app/apps/api/dist ./apps/api/dist

# Install production dependencies
RUN npm install --omit=dev

EXPOSE 4000

CMD ["node", "apps/api/dist/server.js"]
